# ---- Core ----
PORT=4000
NODE_ENV=development
APP_URL=http://localhost:4000
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL=7d

# ---- Data ----
# Where the SQLite database and uploaded files live (Postgres is the production target, see docs/ARCHITECTURE.md)
DATA_DIR=./data
DB_FILE=./data/buybuddy.sqlite

# ---- Payments (leave blank to run the built-in sandbox checkout) ----
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_MOCK=true
FLUTTERWAVE_SECRET_KEY=

# ---- Messaging / notifications ----
SMS_PROVIDER=            # termii | twilio — blank = log codes to the console
SMS_API_KEY=
FCM_SERVER_KEY=

# ---- Maps ----
GOOGLE_MAPS_API_KEY=

# ---- Production hardening ----
LOG_REQUESTS=true            # structured JSON request logs
DISABLE_RATE_LIMIT=false     # never true in production
CSP_FRAME_ANCESTORS=         # e.g. "'none'" in production to block framing
FORCE_HSTS=false

# ---- Postgres (only for the migration path — SQLite is used by default) ----
DATABASE_URL=

# ---- Litestream (continuous SQLite replication to object storage) ----
LITESTREAM_BUCKET=
LITESTREAM_REGION=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# ---- Growth features ----
# Loyalty, referrals and scheduling are configured at runtime in
# Admin → Settings; these defaults live in server/src/lib/settings.js.

# ---- Auth conveniences for local testing ----
ALLOW_DEV_OTP=true       # accepts 000000 as a universal OTP outside production
